# Skopíruj tento súbor do .env.local a doplň hodnoty zo Supabase projektu
# (Dashboard → Project Settings → API). .env.local sa necommituje (viď .gitignore).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NIKDY sem nedávaj service_role kľúč. Ten patrí iba do Supabase Edge Functions
# / serverového prostredia, nikdy do frontendového buildu.
